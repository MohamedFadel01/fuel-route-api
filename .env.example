# Copy to .env and adjust. Used by docker-compose; for local runs export the variables.

# Leave empty to use a random per-process key (fine for local development).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave false for the local HTTP demo. Set true only behind a proxy that terminates TLS.
DJANGO_USE_HTTPS=false

# SQLite file location (defaults to ./db.sqlite3).
DATABASE_PATH=

# Only used by `manage.py geocode_stations`. The Nominatim usage policy asks you to
# identify your application, ideally with a contact address.
NOMINATIM_USER_AGENT=
NOMINATIM_BASE_URL=

# Routing service used by POST /api/v1/route/ (one request per trip). Defaults to the free
# public OSRM demo server; point it at your own OSRM for heavier use.
OSRM_BASE_URL=
OSRM_TIMEOUT_SECONDS=
OSRM_USER_AGENT=

# Refuse a trip whose start or finish is further than this from the nearest road (miles).
MAX_SNAP_MILES=
# Seconds to reuse an identical trip without a new routing call. 0 asks every time.
TRIP_CACHE_SECONDS=
